<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>TaxoStore.Cli</RootNamespace>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<DefineConstants>SERILOG_SINKS_CONSOLE</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="appsettings.json" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Fusi.Cli.Config" />
		<PackageReference Include="Fusi.Cli.Logging" />
		<PackageReference Include="Serilog.Sinks.Console" />
		<PackageReference Include="Spectre.Console" />
		<PackageReference Include="Spectre.Console.Cli" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\TaxoStore.Cli.Core\TaxoStore.Cli.Core.csproj" />
	</ItemGroup>

</Project>
